{
  "appId": "id.imm.inbound",
  "appName": "Mini Monitoring",
  "webDir": "www",
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#111820"
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": true
    },
    "SystemBars": {
      "insetsHandling": "css",
      "initialViewportFitValueHint": "cover"
    },
    "CapacitorUpdater": {
      "autoUpdate": false,
      "appReadyTimeout": 20000,
      "resetWhenUpdate": true,
      "autoDeleteFailed": true,
      "autoDeletePrevious": true,
      "statsUrl": "",
      "updateUrl": "",
      "channelUrl": "",
      "allowModifyUrl": false,
      "shakeMenu": false,
      "keepUrlPathAfterReload": false
    }
  },
  "server": {
    "androidScheme": "https"
  }
}